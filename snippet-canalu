/**
 * Shortcode Canal-U pour WordPress
 * Usage: [canalu chaine="drones-cap"]
 * A installer via le plugin Code Snippets (sans la balise php du debut)
 * Recupere l'integralite des videos via le flux RSS de la chaine (pas de pagination a gerer)
 */

// Garde une trace de chaque tentative de recuperation de vignette pour le panneau debug
function canalu_thumbnail_debug_log($entry = null) {
    static $log = array();
    if ($entry !== null) {
        $log[] = $entry;
    }
    return $log;
}

// canal-u.tv bloque (HTTP 403 + page "bot_challenge") l'IP du serveur des qu'elle enchaine plusieurs pages video d'affilee.
// Reessayer ne sert a rien (le blocage n'est pas aleatoire par requete) : on detecte le 403 et on coupe immediatement
// toutes les tentatives suivantes pour ce chargement, pour ne pas prolonger/aggraver le blocage. Nouvel essai ~15 min plus tard.
function canalu_antibot_blocked() {
    return get_transient('canalu_antibot_block') !== false;
}

function canalu_mark_antibot_blocked() {
    set_transient('canalu_antibot_block', true, 15 * MINUTE_IN_SECONDS);
}

// Le flux RSS fournit une URL HLS dans l'enclosure.
// On peut en deduire directement l'image poster sans ouvrir la page video.
function canalu_thumbnail_from_enclosure($enclosure_url) {
    $enclosure_url = trim((string) $enclosure_url);
    if ($enclosure_url === '') {
        return '';
    }

    $pattern = '#^https://vod\.canal-u\.tv/hls/(\d{4})/(\d{2})/(\d+)/([^,/_]+(?:_[^,/_]+)*)#i';
    if (!preg_match($pattern, $enclosure_url, $matches)) {
        return '';
    }

    return sprintf(
        'https://vod.canal-u.tv/videos/%s/%s/%s/%s.jpg',
        $matches[1],
        $matches[2],
        $matches[3],
        $matches[4]
    );
}

// Le flux RSS n'a pas de vignette par video : on va la chercher sur la page de la video (balise og:image), avec un cache dedie
// Seule une vignette trouvee avec succes est mise en cache longtemps ; un echec n'est garde que quelques minutes pour pouvoir reessayer
// $budget limite le nombre de vraies requetes HTTP par chargement de page : canal-u.tv bloque/ralentit si on enchaine trop de requetes d'un coup,
// le reste des vignettes se remplira progressivement au fil des prochains chargements (chaque succes est cache 1 semaine, donc jamais redemande)
function canalu_fetch_video_thumbnail($link, $fallback, &$budget) {
    $thumb_key = 'canalu_thumb_v2_' . md5($link);
    $cached = get_transient($thumb_key);

    if ($cached !== false) {
        canalu_thumbnail_debug_log(array('link' => $link, 'source' => 'cache', 'found' => !empty($cached)));
        return !empty($cached) ? $cached : $fallback;
    }

    if ($budget <= 0) {
        canalu_thumbnail_debug_log(array('link' => $link, 'found' => false, 'error' => 'budget de requetes epuise pour ce chargement'));
        return $fallback;
    }

    if (canalu_antibot_blocked()) {
        $budget = 0;
        canalu_thumbnail_debug_log(array('link' => $link, 'found' => false, 'error' => 'anti-bot canal-u.tv actif, nouvel essai dans ~15 min'));
        return $fallback;
    }
    $budget--;

    $response = wp_remote_get($link, array(
        'timeout' => 10,
        'redirection' => 5,
        'user-agent' => 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
    ));

    if (is_wp_error($response)) {
        set_transient($thumb_key, '', 10 * MINUTE_IN_SECONDS);
        canalu_thumbnail_debug_log(array('link' => $link, 'found' => false, 'error' => $response->get_error_message()));
        return $fallback;
    }

    $status_code = wp_remote_retrieve_response_code($response);
    if ($status_code !== 200) {
        if ($status_code === 403) {
            canalu_mark_antibot_blocked();
            $budget = 0;
        }
        set_transient($thumb_key, '', 10 * MINUTE_IN_SECONDS);
        canalu_thumbnail_debug_log(array('link' => $link, 'found' => false, 'status_code' => $status_code));
        return $fallback;
    }

    $body = wp_remote_retrieve_body($response);
    if (preg_match('/<meta[^>]+property=["\']og:image["\'][^>]+content=["\']([^"\']+)["\']/i', $body, $m)
        || preg_match('/<meta[^>]+content=["\']([^"\']+)["\'][^>]+property=["\']og:image["\']/i', $body, $m)) {
        $thumbnail = html_entity_decode($m[1], ENT_QUOTES | ENT_HTML5, 'UTF-8');
        set_transient($thumb_key, $thumbnail, WEEK_IN_SECONDS);
        canalu_thumbnail_debug_log(array('link' => $link, 'found' => true, 'status_code' => $status_code));
        return $thumbnail;
    }

    set_transient($thumb_key, '', 10 * MINUTE_IN_SECONDS);
    canalu_thumbnail_debug_log(array('link' => $link, 'found' => false, 'status_code' => $status_code, 'body_length' => strlen($body)));
    return $fallback;
}


function canalu_shortcode($atts) {
    $atts = shortcode_atts(array(
        'chaine' => '',
        'limite' => 200,
        'debug' => false,
        'clear' => false,
    ), $atts);

    $atts['debug'] = filter_var($atts['debug'], FILTER_VALIDATE_BOOLEAN);
    $atts['clear'] = filter_var($atts['clear'], FILTER_VALIDATE_BOOLEAN);

    if (empty($atts['chaine'])) {
        return '<p style="color: red;">Erreur : Veuillez specifier le nom de la chaine avec l\'attribut "chaine"</p>';
    }

    $chaine_slug = strtolower(trim($atts['chaine']));
    $transient_key = 'canalu_rss_v4_' . md5($chaine_slug);

    // L'attribut clear="true" permet de forcer un rafraichissement complet sans toucher au code (a retirer une fois le test fait)
    if ($atts['clear']) {
        delete_transient($transient_key);
    }

    $result = get_transient($transient_key);

    if ($result === false) {
        $debug_parse = array('slug_attempts' => array());

        // Essaye plusieurs variantes du slug pour trouver le bon flux RSS de la chaine
        $original_slug = trim($atts['chaine']);
        $variants = array_unique(array(
            $original_slug,
            strtolower($original_slug),
            str_replace(' ', '-', strtolower($original_slug)),
            str_replace('-', ' ', strtolower($original_slug)),
        ));

        $xml = null;
        $chaine_titre = '';
        $chaine_image = '';

        foreach ($variants as $variant) {
            $variant = trim($variant);
            if ($variant === '') continue;

            $rss_url = 'https://www.canal-u.tv/chaines/' . rawurlencode($variant) . '/rss';
            $response = wp_remote_get($rss_url, array(
                'timeout' => 20,
                'user-agent' => 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
            ));

            $attempt = array('slug' => $variant, 'url' => $rss_url);

            if (is_wp_error($response)) {
                $attempt['error'] = $response->get_error_message();
                $debug_parse['slug_attempts'][] = $attempt;
                continue;
            }

            $attempt['status_code'] = wp_remote_retrieve_response_code($response);
            $body = wp_remote_retrieve_body($response);
            $attempt['body_length'] = strlen($body);

            if ($attempt['status_code'] !== 200 || empty($body)) {
                $debug_parse['slug_attempts'][] = $attempt;
                continue;
            }

            libxml_use_internal_errors(true);
            $parsed = simplexml_load_string($body);
            libxml_use_internal_errors(false);

            if ($parsed === false || empty($parsed->channel->item)) {
                $attempt['error'] = 'Flux RSS invalide ou sans video';
                $debug_parse['slug_attempts'][] = $attempt;
                continue;
            }

            $attempt['items_found'] = count($parsed->channel->item);
            $debug_parse['slug_attempts'][] = $attempt;

            $xml = $parsed;
            $chaine_titre = trim((string) $parsed->channel->title);
            $chaine_image = isset($parsed->channel->image->url) ? trim((string) $parsed->channel->image->url) : '';
            break;
        }

        if ($xml === null) {
            $error_html = '<p style="color: red;">Erreur : Impossible de recuperer le flux RSS de la chaine.</p>';
            if ($atts['debug']) {
                $error_html .= '<div style="background: #f0f0f0; border: 2px solid #cc0000; padding: 20px; margin: 20px 0; font-family: monospace; font-size: 12px;">';
                $error_html .= '<h4 style="margin-top: 0; color: #cc0000;">Debug : tentatives de flux RSS</h4>';
                $error_html .= '<pre style="background: white; padding: 10px; overflow: auto; font-size: 11px; max-height: 500px;">' . esc_html(print_r($debug_parse, true)) . '</pre>';
                $error_html .= '</div>';
            } else {
                $error_html .= '<p style="color: #0066cc;">Ajoutez <code>debug="true"</code> pour plus de details</p>';
            }
            return $error_html;
        }

        // Le flux RSS contient directement toutes les videos de la chaine, sans pagination
        $all_videos = array();
        $fallback_thumbnail = !empty($chaine_image) ? $chaine_image : 'https://via.placeholder.com/560x315?text=Canal-U';
        $limite = (int) $atts['limite'];
        if ($limite <= 0) {
            $limite = 200;
        }
        // Les vignettes viennent d'abord de l'URL HLS du flux RSS.
        // On garde un petit budget de repli sur les pages video uniquement si ce calcul echoue.
        $thumb_fetch_budget = 8;

        foreach ($xml->channel->item as $item) {
            if (count($all_videos) >= $limite) {
                break;
            }

            $title = trim((string) $item->title);
            $link = trim((string) $item->link);

            if (empty($title) || empty($link)) {
                continue;
            }

            $description = trim((string) $item->description);
            if (strlen($description) > 250) {
                $description = substr($description, 0, 250) . '...';
            }

            $date = '';
            $timestamp = strtotime((string) $item->pubDate);
            if ($timestamp) {
                $date = date_i18n('d/m/Y', $timestamp);
            }

            $enclosure_url = '';

            // L'attribut "length" de l'enclosure correspond a la duree de la video en secondes
            $duree = '';
            if (isset($item->enclosure)) {
                $enclosure_attributes = $item->enclosure->attributes();
                $enclosure_url = isset($enclosure_attributes['url']) ? trim((string) $enclosure_attributes['url']) : '';
                $seconds = (int) $enclosure_attributes->length;
                if ($seconds > 0) {
                    $duree = sprintf('%d:%02d', floor($seconds / 60), $seconds % 60);
                }
            }

            $thumbnail = canalu_thumbnail_from_enclosure($enclosure_url);
            if (!empty($thumbnail)) {
                canalu_thumbnail_debug_log(array('link' => $link, 'source' => 'enclosure', 'found' => true));
            } else {
                $thumbnail = canalu_fetch_video_thumbnail($link, $fallback_thumbnail, $thumb_fetch_budget);
            }

            $all_videos[] = array(
                'title' => $title,
                'link' => $link,
                'thumbnail' => $thumbnail,
                'auteurs' => '',
                'description' => $description,
                'type' => '',
                'duree' => $duree,
                'date' => $date,
                'niveau' => 0,
                'documents' => 0,
            );
        }

        $result = array(
            'chaine_id' => $chaine_titre,
            'videos' => $all_videos,
            'debug_parse' => $debug_parse,
        );

        if (!empty($all_videos)) {
            set_transient($transient_key, $result, HOUR_IN_SECONDS);
        }
    }

    $videos = $result['videos'];

    if (empty($videos)) {
        $debug_info = '<p>Aucune video trouvee pour la chaine "' . esc_html($atts['chaine']) . '".</p>';
        if (!empty($result['chaine_id'])) {
            $debug_info .= '<p style="color: #666; font-size: 14px;">Chaine trouvee : ' . esc_html($result['chaine_id']) . '</p>';
        }

        if ($atts['debug']) {
            $debug_info .= '<div style="background: #f0f0f0; border: 2px solid #cc0000; padding: 20px; margin: 20px 0; font-family: monospace; font-size: 12px;">';
            $debug_info .= '<h4 style="margin-top: 0; color: #cc0000;">Debug Complet</h4>';
            if (!empty($result['debug_parse'])) {
                $debug_info .= '<pre style="background: white; padding: 10px; overflow: auto; font-size: 10px; max-height: 500px;">' . esc_html(print_r($result['debug_parse'], true)) . '</pre>';
            }
            $debug_info .= '</div>';
        } else {
            $debug_info .= '<p style="color: #0066cc;">Ajoutez <code>debug="true"</code> pour plus de details</p>';
        }

        return $debug_info;
    }

    ob_start();

    if ($atts['debug']) {
        echo '<div style="background: #f0f0f0; border: 2px solid #0066cc; padding: 20px; margin: 20px 0; font-family: monospace; font-size: 12px;">';
        echo '<h4 style="margin-top: 0; color: #0066cc;">Debug Info</h4>';
        echo '<p><strong>Chaine:</strong> ' . esc_html($result['chaine_id']) . '</p>';
        echo '<p><strong>Videos trouvees dans le flux RSS:</strong> ' . count($result['videos']) . '</p>';
        echo '<p><strong>Videos affichees:</strong> ' . count($videos) . '</p>';
        if (!empty($videos[0])) {
            echo '<p><strong>Premiere video:</strong> ' . esc_html($videos[0]['title']) . '</p>';
        }

        // Afficher le detail des tentatives de flux RSS
        if (!empty($result['debug_parse']['slug_attempts'])) {
            echo '<h5 style="margin: 15px 0 10px; color: #0066cc;">Tentatives de flux RSS:</h5>';
            echo '<table style="width: 100%; border-collapse: collapse; background: white;">';
            echo '<tr style="background: #0066cc; color: white;">';
            echo '<th style="padding: 8px; border: 1px solid #ddd;">Slug essaye</th>';
            echo '<th style="padding: 8px; border: 1px solid #ddd;">Code HTTP</th>';
            echo '<th style="padding: 8px; border: 1px solid #ddd;">Videos trouvees</th>';
            echo '<th style="padding: 8px; border: 1px solid #ddd;">Erreur</th>';
            echo '</tr>';

            foreach ($result['debug_parse']['slug_attempts'] as $attempt) {
                echo '<tr>';
                echo '<td style="padding: 8px; border: 1px solid #ddd;">' . esc_html($attempt['slug']) . '</td>';
                echo '<td style="padding: 8px; border: 1px solid #ddd; text-align: center;">' . (isset($attempt['status_code']) ? esc_html($attempt['status_code']) : '-') . '</td>';
                echo '<td style="padding: 8px; border: 1px solid #ddd; text-align: center; background: #d4edda;">' . (isset($attempt['items_found']) ? esc_html($attempt['items_found']) : '-') . '</td>';
                echo '<td style="padding: 8px; border: 1px solid #ddd; background: #f8d7da;">' . (isset($attempt['error']) ? esc_html($attempt['error']) : '') . '</td>';
                echo '</tr>';
            }
            echo '</table>';
        }

        // Afficher le detail des tentatives de recuperation des vignettes (vide si la liste venait du cache principal)
        $thumb_log = canalu_thumbnail_debug_log();
        if (!empty($thumb_log)) {
            echo '<h5 style="margin: 15px 0 10px; color: #0066cc;">Tentatives de vignettes (' . count($thumb_log) . '):</h5>';
            echo '<table style="width: 100%; border-collapse: collapse; background: white;">';
            echo '<tr style="background: #0066cc; color: white;">';
            echo '<th style="padding: 8px; border: 1px solid #ddd;">Lien video</th>';
            echo '<th style="padding: 8px; border: 1px solid #ddd;">Source</th>';
            echo '<th style="padding: 8px; border: 1px solid #ddd;">Trouvee</th>';
            echo '<th style="padding: 8px; border: 1px solid #ddd;">Code HTTP</th>';
            echo '<th style="padding: 8px; border: 1px solid #ddd;">Erreur / taille body</th>';
            echo '</tr>';

            foreach ($thumb_log as $entry) {
                $found = !empty($entry['found']);
                echo '<tr>';
                echo '<td style="padding: 8px; border: 1px solid #ddd; word-break: break-all;">' . esc_html($entry['link']) . '</td>';
                echo '<td style="padding: 8px; border: 1px solid #ddd; text-align: center;">' . esc_html($entry['source'] ?? 'fetch') . '</td>';
                echo '<td style="padding: 8px; border: 1px solid #ddd; text-align: center; background: ' . ($found ? '#d4edda' : '#f8d7da') . ';">' . ($found ? 'oui' : 'non') . '</td>';
                echo '<td style="padding: 8px; border: 1px solid #ddd; text-align: center;">' . (isset($entry['status_code']) ? esc_html($entry['status_code']) : '-') . '</td>';
                echo '<td style="padding: 8px; border: 1px solid #ddd;">' . esc_html($entry['error'] ?? (isset($entry['body_length']) ? $entry['body_length'] . ' octets' : '')) . '</td>';
                echo '</tr>';
            }
            echo '</table>';
        } else {
            echo '<p style="color: #666;"><em>Liste des videos servie depuis le cache principal (' . esc_html($transient_key) . ') : aucune nouvelle tentative de vignette cette fois-ci.</em></p>';
        }

        echo '</div>';
    }
